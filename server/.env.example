# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example MongoDB Atlas format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillbridge?retryWrites=true&w=majority
# Local MongoDB format:
# MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
# If left blank, the server automatically uses in-memory MongoDB for easy zero-setup viva demos!
MONGODB_URI=

# JWT Secret Key
JWT_SECRET=skillbridge_super_secure_jwt_secret_token_2026

# JWT Expiration
JWT_EXPIRE=30d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
